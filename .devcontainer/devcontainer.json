{
    "name": "project_milo",
    "dockerComposeFile": "docker-compose.yml",
    "service": "milo-devcontainer-user",
    "workspaceFolder": "/project_milo",
    "remoteUser": "ubuntu",
    "overrideCommand": false,
    "shutdownAction": "stopContainer",
    "postCreateCommand": "bash .devcontainer/scripts/post_create.sh",
    // Handle port forwarding in the future for foxglove and webdev
    // "forwardPorts": [80, 3000, 3100, 4200, 4300, 5432, 8088, 8888, 9000, 9001, 9003],
    // "portsAttributes": {
    //     "80": { "label": "Fleet reverse proxy" },
    //     "3000": { "label": "Fleet backend API" },
    //     "3100": { "label": "Fleet analyzer backend" },
    //     "4200": { "label": "Fleet frontend" },
    //     "4300": { "label": "Fleet analyzer frontend" },
    //     "5432": { "label": "Fleet Postgres" },
    //     "8088": { "label": "Fleet simulation manager" },
    //     "8888": { "label": "Fleet analyzer data service" },
    //     "9000": { "label": "Fleet MinIO API" },
    //     "9001": { "label": "Fleet MQTT websocket" },
    //     "9003": { "label": "Fleet MinIO console" }
    // },
    "customizations": {
        "vscode": {
        "settings": {
            "terminal.integrated.defaultProfile.linux": "zsh",
            "terminal.integrated.profiles.linux": {
            "zsh": { "path": "/usr/bin/zsh" }
            },
            "python.defaultInterpreterPath": "/usr/local/bin/python",
            "editor.formatOnSave": true,
            "files.trimTrailingWhitespace": true
        },
        "extensions": [
            // AI / Copilot
            // "github.copilot",
            // "github.copilot-chat",
            // "openai.chatgpt",
            // "anthropic.claude-code",
            
            // Python
            "ms-python.python",
            "ms-python.vscode-pylance",
            "ms-python.debugpy",
            "charliermarsh.ruff",
            "ms-python.mypy-type-checker",
            // Git
            "eamodio.gitlens",
            // Quality-of-life
            "christian-kohler.path-intellisense",
            "usernamehw.errorlens",
            "shardulm94.trailing-spaces",
            "davidanson.vscode-markdownlint"
      ]
    }
  }
}