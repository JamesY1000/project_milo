<?xml version="1.0"?>
<robot xmlns:xacro="https://www.ros.org/wiki/xacro" name="robot">

    <xacro:include filename="robot_core.xacro" />

    <!-- DIFF DRIVE CONTROL -->
    <xacro:include filename="controllers/diff_drive_control.xacro"/>

    <!-- CUSTOM ROS2 CONTROL - currently laser scanner moves in rviz bug-->
    <!-- <xacro:include filename="ros2_control.xacro" /> -->

    <!-- LiDAR -->
    <xacro:include filename="lidars/lidar.xacro"/>

    <!-- Camera -->
    <xacro:include filename="cameras/camera.xacro"/>

    <!-- IMU -->
    <xacro:include filename="imu/imu.xacro"/>
    
</robot> 