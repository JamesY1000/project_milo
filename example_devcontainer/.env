# Template for local devcontainer overrides.
# 00_devcontainer_init.sh copies this file to .devcontainer/.env on first init.

# Registry used for reusable devcontainer images.
MATERIAL_FLOW_REGISTRY=registry.arculus.it/material-flow/material-flow

# Version tag shared by reusable base, Fleet, and user images.
# Architecture is encoded in the image name, for example
# material-flow-devcontainer-base-arm64:latest.
IMAGE_TAG=latest

# Auto-generated by the init script on first run and used in reusable image names.
PLATFORM=

# "runc" for standard; "nvidia" for GPU hosts with NVIDIA Container Toolkit.
CONTAINER_RUNTIME=runc
# "no" for standard; "unless-stopped" survives host reboots but respects manual stops.
RESTART_POLICY=no

# Node.js major version
NODE_VERSION=20

# ROS 2 distribution for the binary Open-RMF underlay in the base image.
ROS_DISTRO=jazzy

# Fleet devcontainer layer inputs.
FLEET_RUST_BASE_IMAGE=registry.arculus.it/fleet/fleet/rust-base-or-tools:1.1.0-rust1.95.0
FLEET_NODE_VERSION=24.9.0
FLEET_NPM_VERSION=11.6.0

# Optional non-interactive image preparation overrides: ensure, build, pull, or keep.
DEVCONTAINER_BASE_IMAGE_ACTION=
DEVCONTAINER_FLEET_IMAGE_ACTION=