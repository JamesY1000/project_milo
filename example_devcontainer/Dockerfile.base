ARG ROS_DISTRO=jazzy
ARG ROS_BASE_IMAGE=registry.arculus.it/devops/container-images/mirrors/ros:${ROS_DISTRO}-ros-base-noble
FROM ${ROS_BASE_IMAGE}
ARG NODE_VERSION=20

# Ubuntu 24.04 (Noble) already provides user 'ubuntu' with UID/GID 1000
ENV USER=ubuntu

# Setup environment
ENV ROS_DISTRO=${ROS_DISTRO}
ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=en_US.UTF-8
ENV LANGUAGE=${LANG}
ENV LC_ALL=${LANG}

# Allow pip to install packages system-wide (dev container, not production)
ENV PIP_BREAK_SYSTEM_PACKAGES=1
ENV PATH=/opt/minizinc/bin:${PATH}

#  System packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    sudo \
    curl wget git ca-certificates gnupg \
    build-essential nano \
    ccache \
    locales \
    python3 python3-pip python3-venv python3-tk \
    minizinc \
    openssh-client \
    zsh \
    iproute2 procps lsof \
    jq ripgrep fd-find shellcheck \
    less vim-tiny \
    && locale-gen en_US.UTF-8 \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && ln -sf /usr/bin/fdfind /usr/local/bin/fd \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Open-RMF underlay and ROS development tooling
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-vcstool \
    ros-${ROS_DISTRO}-rmf-dev \
    ros-${ROS_DISTRO}-rviz2 \
    ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

#  Install Node.js
RUN curl -fsSL https://deb.nodesource.com/setup_${NODE_VERSION}.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Used by documentation skills to validate Mermaid diagrams via `mmdc`.
RUN npm install -g @mermaid-js/mermaid-cli@11.15.0 \
    && mmdc --version

RUN if [ ! -f /etc/ros/rosdep/sources.list.d/20-default.list ]; then rosdep init; fi \
    && rosdep update --rosdistro "${ROS_DISTRO}"

#  Pre-install Python dev tools globally
COPY .devcontainer/requirements.txt /tmp/devcontainer-requirements.txt
RUN pip install --no-cache-dir -r /tmp/devcontainer-requirements.txt \
    && rm /tmp/devcontainer-requirements.txt

WORKDIR /material-flow
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp